# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

# Autostarts
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --all
exec waybar -c ~/.config/waybar/config_sway.jsonc
exec awww-daemon
exec awww img $HOME/Pictures/wallpapers/cut/2.jpg --outputs DP-2
exec awww img $HOME/Pictures/wallpapers/cut/1.jpg --outputs DP-3
exec mako
exec signal-desktop --start-in-tray
exec nm-applet --indicator
exec blueman-applet
exec gnome-keyring-daemon -d
exec sleep 1 && /usr/lib/xdg-desktop-portal-wlr
exec sleep 2 && /usr/lib/xdg-desktop-portal
exec otd-daemon

# Outputs
output DP-2 resolution 2560x1440@180Hz position 0,0
output DP-3 resolution 1920x1080@144Hz position -1920,0
output HDMI-A-1 resolution 1920x1080@60Hz position 0,1440

workspace "bind" output DP-3
workspace "my_scratchpad" output DP-2

default_orientation horizontal
xwayland enable

# Inputs
# Keyboard
input * {
    xkb_layout pl
    repeat_rate 25
    repeat_delay 600
}

# Trackpad
input type:touchpad {
    tap enabled
    drag enabled
    drag_lock enabled
    dwt enabled
    natural_scroll disabled
    left_handed disabled
    middle_emulation disabled
}

# Mouse
input type:pointer {
    natural_scroll disabled
}

# Theming
#	Gaps & Borders
gaps inner 10
gaps outer 10
default_border pixel 2
default_floating_border pixel 2

#	 Colors
#		Format: class       border  bground text    indicator child_border
client.focused              #AB47BC #AB47BC #ffffff #AB47BC   #AB47BC
client.focused_inactive     #505050 #505050 #ffffff #505050   #505050
client.unfocused            #505050 #201b14 #ffffff #505050   #505050
client.urgent               #9b0000 #9b0000 #ffffff #9b0000   #9b0000

#	Other window settings
focus_follows_mouse yes
mouse_warping output


# Keybinds
set $mod Mod4

# Core Actions
bindsym $mod+Mod1+r reload
bindsym $mod+Escape exec $HOME/.config/sway/bemenu-logout.sh
bindsym $mod+Control+Escape exec swaymsg exit
bindsym $mod+backslash input * xkb_switch_layout next

bindsym $mod+t exec wezterm
bindsym $mod+r exec $HOME/.config/sway/start-bemenu.sh
bindsym $mod+f exec thunar
bindsym Print exec $HOME/.config/sway/take_screenshot.sh
bindsym $mod+q kill

# Window Focus
bindsym $mod+Tab focus next
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Move Windows (Swap in Sway)
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right

# Window Status Toggles
bindsym $mod+Mod1+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+m fullscreen toggle

bindsym $mod+Mod1+m move scratchpad
bindsym $mod+Mod1+Control+m scratchpad show
bindsym $mod+Mod1+Control+Shift+s scratchpad show

# Layout Switcher (Sway uses split / tabbed / stacking paradigms)
bindsym $mod+n layout toggle split tabbed stacking

# Switch to Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+s workspace my_scratchpad

# Move window to Workspaces
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+s move container to workspace my_scratchpad

# Mouse bindings
floating_modifier $mod normal
bindsym --whole-window $mod+button2 fullscreen toggle

#Eye-candy

corner_radius 10
smart_corner_radius enable

shadows enabled
shadows_on_csd enable
shadow_blur_radius 5
shadow_color #0000007F

blur enabled
blur_xray off
blur_passes 2
blur_radius 5

default_dim_inactive 0.2
dim_inactive_colors.unfocused #0000007F
dim_inactive_colors.urgent #9000007F

scratchpad_minimize disable

exec /usr/share/sway-contrib/inactive-windows-transparency.py -o 0.8

include /etc/sway/config.d/*
